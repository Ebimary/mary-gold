# Mary Gold — contact form delivery (all optional)
#
# The site works WITHOUT these (it falls back to opening the visitor's
# email client). Configure them to receive form submissions by email.

# Option 1 — Resend (recommended, free tier): https://resend.com
RESEND_API_KEY=
CONTACT_TO=bongwemary2020@gmail.com
CONTACT_FROM=website@yourdomain.com

# Option 2 — generic webhook (Slack, Discord, Zapier, Make, etc.)
CONTACT_WEBHOOK=
